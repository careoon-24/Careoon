datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  NURSE
  ADMIN
}

enum VerificationStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum BookingStatus {
  DRAFT
  PAYMENT_PENDING
  SEARCHING_NURSE
  NURSE_OFFERED
  CONFIRMED
  NURSE_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  FAILED
  REFUNDED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PayableStatus {
  UNPAID
  BATCHED
  PAID
}

enum BatchStatus {
  OPEN
  LOCKED
  PROCESSING
  PAID
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String    @unique
  fullName     String
  role         Role      @default(PATIENT)
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Patient Health Profile & Auto-fill Address
  age                     Int?
  gender                  String?
  bloodGroup              String?
  addressStreet           String?
  addressApartment        String?
  addressCity             String?           @default("Sangli")
  addressPincode          String?           @default("416416")
  emergencyContactName    String?
  emergencyContactPhone   String?
  chronicConditions       String?
  allergies               String?
  savedFamilyMembers      String?           // JSON array of saved family members

  nurseProfile   NurseProfile?
  patientBookings Booking[]       @relation("PatientBookings")
  patientReviews  Review[]        @relation("PatientReviews")
  supportTickets  SupportTicket[] @relation("UserTickets")
  auditLogs       AuditLog[]      @relation("ActorAuditLogs")
}

model NurseProfile {
  id                        String             @id @default(uuid())
  userId                    String             @unique
  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  nurseCode                 String?            @unique // Unique System ID e.g. "SANGLI-RN-7401"
  registrationNumber        String
  qualifications            String             // JSON string or comma-separated
  experienceYears           Int                @default(1)
  bio                       String?
  serviceRadiusKm           Float              @default(10.0)
  latitude                  Float              @default(16.8524) // Sangli Center
  longitude                 Float              @default(74.5815)
  policeVerificationStatus  VerificationStatus @default(PENDING)
  adminApprovalStatus       VerificationStatus @default(PENDING)
  ratingAverage             Float              @default(5.0)
  ratingCount               Int                @default(0)
  isAvailableNow            Boolean            @default(true)
  bankAccountNumber         String?
  bankIfsc                  String?
  bankHolderName            String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  assignedBookings          Booking[]          @relation("AssignedNurseBookings")
  offers                    BookingOffer[]
  payables                  Payable[]
  reviews                   Review[]           @relation("NurseReviews")
}

model ServiceCategory {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  displayOrder Int      @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  services    Service[]
}

model Service {
  id                 String          @id @default(uuid())
  categoryId         String
  category           ServiceCategory @relation(fields: [categoryId], references: [id])
  name               String
  slug               String          @unique
  description        String
  shortDescription   String?
  basePrice          Float
  durationMinutes    Int
  commissionPercent  Float           @default(15.0)
  eligibilityRules   String?         // JSON string array of requirements
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  bookings           Booking[]
}

model Booking {
  id                   String        @id @default(uuid())
  bookingCode          String        @unique
  patientId            String
  patient              User          @relation("PatientBookings", fields: [patientId], references: [id])
  serviceId            String
  service              Service       @relation(fields: [serviceId], references: [id])
  nurseId              String?
  assignedNurse        NurseProfile? @relation("AssignedNurseBookings", fields: [nurseId], references: [id])
  
  scheduledDate        String        // YYYY-MM-DD
  scheduledTime        String        // HH:MM
  durationMinutes      Int           @default(60)
  
  addressLine          String
  landmark             String?
  city                 String
  postalCode           String
  latitude             Float?
  longitude            Float?
  
  patientNotes         String?
  patientContactPhone  String
  patientName          String
  patientAge           Int?
  patientGender        String?
  
  // Financial Snapshot (Immutable once confirmed)
  servicePrice         Float
  commissionPercent    Float
  commissionAmount     Float
  nurseEarningsAmount  Float
  tipAmount            Float         @default(0)
  couponCode           String?
  discountAmount       Float         @default(0)
  totalPatientAmount   Float
  
  status               BookingStatus @default(DRAFT)
  paymentStatus        PaymentStatus @default(UNPAID)
  
  arrivalNotes         String?
  clinicalNotes        String?
  vitalSigns           String?       // JSON string: { bp: "120/80", pulse: 76, sugar: 110, spo2: 99, temp: 98.4 }
  prescriptionNotes    String?
  arrivedAt            DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  offers               BookingOffer[]
  payments             Payment[]
  payables             Payable[]
  reviews              Review[]
  supportTickets       SupportTicket[]
}

model BookingOffer {
  id              String      @id @default(uuid())
  bookingId       String
  booking         Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  nurseId         String
  nurse           NurseProfile @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  status          OfferStatus @default(PENDING)
  sentAt          DateTime    @default(now())
  expiresAt       DateTime
  respondedAt     DateTime?
  rejectionReason String?

  @@index([bookingId])
  @@index([nurseId])
}

model Payment {
  id                  String        @id @default(uuid())
  bookingId           String
  booking             Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount              Float
  currency            String        @default("INR")
  method              String        // UPI, CASH
  status              PaymentStatus @default(PENDING_VERIFICATION)
  paymentRef          String?
  isCashCollected     Boolean       @default(false)
  collectedByNurseId  String?
  collectedAt         DateTime?
  nurseNotes          String?
  failureReason       String?
  reconciledByAdminId String?
  reconciledAt        DateTime?
  createdAt           DateTime      @default(now())
}

model Payable {
  id             String        @id @default(uuid())
  nurseId        String
  nurse          NurseProfile  @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount         Float
  status         PayableStatus @default(UNPAID)
  payoutBatchId  String?
  payoutBatch    PayoutBatch?  @relation(fields: [payoutBatchId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([nurseId])
  @@index([payoutBatchId])
}

model PayoutBatch {
  id                 String      @id @default(uuid())
  batchCode          String      @unique
  periodStart        DateTime
  periodEnd          DateTime
  totalAmount        Float
  status             BatchStatus @default(OPEN)
  processedByAdminId String?
  processedAt        DateTime?
  createdAt          DateTime    @default(now())

  payables           Payable[]
}

model Review {
  id          String       @id @default(uuid())
  bookingId   String
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  patientId   String
  patient     User         @relation("PatientReviews", fields: [patientId], references: [id])
  nurseId     String
  nurse       NurseProfile @relation("NurseReviews", fields: [nurseId], references: [id])
  rating      Int          // 1 to 5
  comment     String?
  isAnonymous Boolean      @default(false)
  createdAt   DateTime     @default(now())
}

model SupportTicket {
  id              String         @id @default(uuid())
  bookingId       String?
  booking         Booking?       @relation(fields: [bookingId], references: [id])
  userId          String
  user            User           @relation("UserTickets", fields: [userId], references: [id])
  subject         String
  description     String
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  assignedAdminId String?
  resolutionNotes String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  actorId    String
  actor      User     @relation("ActorAuditLogs", fields: [actorId], references: [id])
  actorRole  Role
  oldValues  String?  // JSON string
  newValues  String?  // JSON string
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

model Coupon {
  id                String    @id @default(uuid())
  code              String    @unique // e.g. "SANGLI100"
  description       String?   // e.g. "Flat ₹100 Off for Sangli Launch"
  discountType      String    @default("FIXED") // FIXED or PERCENT
  discountValue     Float     // e.g. 100 for FIXED, or 20 for 20%
  minOrderAmount    Float     @default(0)
  maxDiscountAmount Float?
  isActive          Boolean   @default(true)
  expiresAt         DateTime?
  usageCount        Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
